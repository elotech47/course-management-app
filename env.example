# Database Configuration
DATABASE_URL=postgresql://course_admin:your_password@localhost:5432/course_management
POSTGRES_USER=course_admin
POSTGRES_PASSWORD=your_password
POSTGRES_DB=course_management
POSTGRES_PORT=5432

# Backend Configuration
BACKEND_PORT=8000
SECRET_KEY=your-secret-key-change-in-production-min-32-chars
ENVIRONMENT=production

# Frontend Configuration
FRONTEND_PORT=3000
# For production, set this to your API URL (e.g., https://api.lab-grader.space)
VITE_API_URL=http://localhost:8000

# Email Configuration (Optional - for future use)
SENDGRID_API_KEY=your_sendgrid_api_key
FROM_EMAIL=noreply@yourdomain.com

# Deployment Configuration
DEPLOY_MODE=production  # production or development
